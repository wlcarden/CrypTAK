# Headwind MDM (HMDM) environment configuration
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres credentials. SQL_PASS should be a long random string.
SQL_USER=hmdm
SQL_PASS=changeme_long_random_postgres_password
SQL_BASE=hmdm

# ── HMDM service identity ────────────────────────────────────────────────────
# Domain HMDM advertises in URLs it generates. Must match how phones reach it.
# For tailnet-only access this is the IP, not a DNS name.
BASE_DOMAIN=100.64.0.1
LOCAL_IP=100.64.0.1
PROTOCOL=http

# Admin email for the default super-admin account (created on first boot).
ADMIN_EMAIL=admin@tak.local

# Shared secret used to sign device-launcher payloads. Random 32+ chars.
SHARED_SECRET=changeme_shared_secret_32_chars_min

# ── HMDM variant + client ────────────────────────────────────────────────────
# `os` is the open-source community variant. Use `plus` if you have a license.
HMDM_VARIANT=os

# Client app version pinned for fleet rollouts. See HMDM release notes.
CLIENT_VERSION=5.30

# Set to true once on first boot to force HMDM to rewrite config from this env;
# set back to false afterward so subsequent restarts don't churn config.
FORCE_RECONFIGURE=false
